,html.cs740-js.cs740-arm-c .cs740-advice--assignment-failed,html.cs740-js.cs740-arm-excluded .cs740-advice--assignment-failed{display:none!important}html.cs740-js.cs740-arm-a .cs740-advice--arm-a,html.cs740-js.cs740-arm-b .cs740-advice--arm-b,html.cs740-js.cs740-arm-c .cs740-advice--arm-c,html.cs740-js.cs740-arm-excluded .cs740-advice--excluded{display:list-item!important}</style><script data-cfasync="false">window.eightykCs740Config={"cookieName":"cs740_header_arm_v1","reportedCookieName":"cs740_header_reported_v1","cookieMaxAge":34560000,"cookieDomain":".80000hours.org","eligible":true,"forceParam":"cs740_force_arm"};(function(window, document) {
  'use strict';

  var config = window.eightykCs740Config || {};
  var root = document.documentElement;
  var allowedArms = ['a', 'b', 'c'];
  var state = {
    arm: 'assignment_failed',
    status: 'assignment_failed',
    failureReason: 'assignment_did_not_complete',
    needsReporting: false,
    trackingSuppressed: false
  };
  window.eightykCs740 = state;
  root.className += ' cs740-js';

  function isAllowedArm(value) {
    return allowedArms.indexOf(value) !== -1;
  }

  function readCookie(name) {
    var escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    var match = document.cookie.match(new RegExp('(?:^|;\\s*)' + escapedName + '=([^;]+)'));
    return match && match[1] ? decodeURIComponent(match[1]) : '';
  }

  function activate(arm) {
    root.className = root.className.replace(/(?:^|\s)cs740-arm-(?:[abc]|excluded)(?=\s|$)/g, '');
    root.className += ' cs740-arm-' + arm;
  }
  function cookieDomain() {
    var domain = config.cookieDomain || '';
    var bare = domain.replace(/^\./, '');
    var host = window.location.hostname;
    if (!bare) return '';
    return (host === bare || host.slice(-(bare.length + 1)) === '.' + bare) ? domain : '';
  }

  function writeCookie(name, value) {
    var domain = cookieDomain();
    document.cookie = name + '=' + encodeURIComponent(value)
      + '; Max-Age=' + config.cookieMaxAge
      + '; Path=/; SameSite=Lax'
      + (domain ? '; Domain=' + domain : '')
      + (window.location.protocol === 'https:' ? '; Secure' : '');
  }

  window.eightykCs740MarkReported = function() {
    if (!isAllowedArm(state.arm)) return false;
    try {
      writeCookie(config.reportedCookieName, state.arm);
      state.needsReporting = readCookie(config.reportedCookieName) !== state.arm;
      return !state.needsReporting;
    } catch (error) {
      return false;
    }
  };

  function randomArm() {
    var value;
    if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
      var values = new Uint32Array(1);
      window.crypto.getRandomValues(values);
      value = values[0] / 4294967296;
    } else {
      value = Math.random();
    }
    return value < (1 / 3) ? 'a' : (value < (2 / 3) ? 'b' : 'c');
  }

  function excludeForcedQaLinks(arm) {
    function rewrite() {
      var links = document.querySelectorAll('[data-cs740-arm="' + arm + '"] a[href]');
      for (var index = 0; index < links.length; index++) {
        if (links[index].getAttribute('href') === '#') continue;
        try {
          var url = new window.URL(links[index].href, window.location.href);
          url.searchParams.set('cs740_arm', 'excluded');
          if (url.hostname === 'app.80000hours.org') {
            url.searchParams.set('utm_campaign', 'cs740_header_qa');
            url.searchParams.set('utm_content', 'forced_arm_' + arm);
          }
          links[index].href = url.toString();
        } catch (error) {}
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', rewrite);
    } else {
      rewrite();
    }
  }

  try {
    var forceValue = '';
    if (typeof window.URLSearchParams === 'function') {
      forceValue = new window.URLSearchParams(window.location.search).get(config.forceParam) || '';
      forceValue = forceValue.toLowerCase();
    }
    if (isAllowedArm(forceValue)) {
      state.arm = forceValue;
      state.status = 'qa_forced';
      state.failureReason = '';
      state.trackingSuppressed = true;
      activate(forceValue);
      excludeForcedQaLinks(forceValue);
      return;
    }
    if (!config.eligible) {
      state.arm = 'excluded';
      state.status = 'ineligible';
      state.failureReason = '';
      state.trackingSuppressed = true;
      activate('excluded');
      return;
    }

    var existingArm = readCookie(config.cookieName);
    if (isAllowedArm(existingArm)) {
      var alreadyReported = false;
      try {
        alreadyReported = readCookie(config.reportedCookieName) === existingArm;
      } catch (error) {}
      state.arm = existingArm;
      state.status = 'assigned_existing';
      state.failureReason = '';
      state.needsReporting = !alreadyReported;
      activate(existingArm);
      return;
    }

    var arm = randomArm();
    writeCookie(config.cookieName, arm);

    if (readCookie(config.cookieName) !== arm) {
      state.failureReason = 'cookie_write_failed';
      return;
    }

    state.arm = arm;
    state.status = 'assigned_new';
    state.failureReason = '';
    state.needsReporting = true;
    activate(arm);
  } catch (error) {
    state.failureReason = 'assignment_exception';
  }
})(window, document);</script> <link rel="stylesheet" href="https://80000hours.org/wp-content/themes/80000hours/assets/fonts/ymt1nvo-v2.css"><meta name='robots' content='noindex, follow' /><title>Page Not Found | 80,000 Hours</title><meta property="og:locale" content="en_US" /><meta property="og:title" content="Page Not Found | 80,000 Hours" /><meta property="og:site_name" content="80,000 Hours" /> <script type="application/ld+json" class="yoast-schema-graph">{"@context":"https:\/\/schema.org","@graph":[{"@type":"WebSite","@id":"https:\/\/80000hours.org\/#website","url":"https:\/\/80000hours.org\/","name":"80,000 Hours","description":"","publisher":{"@id":"https:\/\/80000hours.org\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/80000hours.org\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/80000hours.org\/#organization","name":"80,000 Hours","url":"https:\/\/80000hours.org\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/80000hours.org\/#\/schema\/logo\/image\/","url":"https:\/\/80000hours.org\/wp-content\/uploads\/2018\/07\/og-logo_0.png","contentUrl":"https:\/\/80000hours.org\/wp-content\/uploads\/2018\/07\/og-logo_0.png","width":1500,"height":785,"caption":"80,000 Hours"},"image":{"@id":"https:\/\/80000hours.org\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/80000Hours","https:\/\/x.com\/80000hours","https:\/\/www.youtube.com\/user\/eightythousandhours"]}]}</script> <style id="wp-img-auto-sizes-contain-inline-css">img:is([sizes=auto i],[sizes^="auto," i]){contain-intrinsic-size:3000px 1500px}
/*# sourceURL=wp-img-auto-sizes-contain-inline-css */</style><style id="classic-theme-styles-inline-css">/**
 * These rules are needed for backwards compatibility.
 * They should match the button element rules in the base theme.json file.
 */
.wp-block-button__link {
	color: #ffffff;
	background-color: #32373c;
	border-radius: 9999px; /* 100% causes an oval, but any explicit but really high value retains the pill shape. */

	/* This needs a low specificity so it won't override the rules from the button element if defined in theme.json. */
	box-shadow: none;
	text-decoration: none;

	/* The extra 2px are added to size solids the same as the outline versions.*/
	padding: calc(0.667em + 2px) calc(1.333em + 2px);

	font-size: 1.125em;
}

.wp-block-file__button {
	background: #32373c;
	color: #ffffff;
	text-decoration: none;
}

