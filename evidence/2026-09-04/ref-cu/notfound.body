          var hasUtm = utmParams.some(function(key) { return params.get(key); });
          if (!hasUtm) return;

          document.querySelectorAll('a[href*="jobs.ashbyhq.com"]').forEach(function(link) {
              try {
                  var url = new URL(link.href);
                  utmParams.forEach(function(key) {
                      var value = params.get(key);
                      if (value) url.searchParams.set(key, value);
                  });
                  link.href = url.toString();
              } catch (e) {}
          });
      });
  

      document.addEventListener('DOMContentLoaded', function() {
          const path = decodeURIComponent(document.location.pathname).replace(/^\/+|\/+$/g, '');
          const pageSlug = path === '' ? 'homepage' : path.replace(/\//g, '__');
          document.querySelectorAll('a[href*="jobs.80000hours.org"]').forEach(function(link) {
              try {
                  var url = new URL(link.href);
                  url.searchParams.set('jb_source', pageSlug);
                  link.href = url.toString();
              } catch (e) {}
          });
      });
  
